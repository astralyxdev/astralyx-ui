{
  "name": "astralyx-ui",
  "version": "0.3.1",
  "type": "module",
  "description": "309 accessible React components you copy into your repo, with a CLI and registry that resolve what each one needs.",
  "license": "MIT",
  "author": "Astralyx",
  "homepage": "https://ui.astralyx.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astralyxdev/astralyx-ui.git"
  },
  "bugs": {
    "url": "https://github.com/astralyxdev/astralyx-ui/issues"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "tailwind",
    "tailwindcss",
    "design-system",
    "accessible",
    "a11y",
    "registry",
    "cli",
    "shadcn",
    "typescript"
  ],
  "bin": {
    "astralyx-ui": "./bin/index.js"
  },
  "files": [
    "bin",
    "registry",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./bin/registry.d.ts",
      "default": "./bin/registry.js"
    },
    "./registry": "./registry/index.json",
    "./registry/*": "./registry/items/*.json",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-props.mjs && tsc -b && vite build && node scripts/build-seo.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:props": "node scripts/build-props.mjs",
    "build:registry": "node scripts/build-registry.mjs",
    "build:cli": "tsc -p tsconfig.cli.json",
    "build:package": "npm run build:props && npm run build:registry && npm run build:cli",
    "prepublishOnly": "npm run build:package",
    "cli": "node bin/index.js"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@hookform/resolvers": "^5.9.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.4",
    "lucide-react": "^1.39.0",
    "oxlint": "^1.79.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "zod": "^4.5.4"
  },
  "types": "./bin/registry.d.ts"
}
